{
  "scope": {
    "domains": [
      "127.0.0.1",
      "localhost"
    ],
    "ip_ranges": [
      "127.0.0.0/8"
    ],
    "allow_private_ips": true,
    "allowed_paths": [
      "/",
      "/api"
    ],
    "blocked_paths": [
      "/admin/delete"
    ]
  },
  "targets": [
    "http://127.0.0.1:8897"
  ],
  "credentials": {
    "type": "cookie",
    "value": "session=PTSKILLTEST-session-abc; Path=/; HttpOnly",
    "verify_url": "https://api.staging.example.test/me"
  },
  "config": {
    "rate_limit_rps": 3,
    "safe_mode": true,
    "require_human_approval": true,
    "environment": "staging",
    "ssrf_sink": "https://oob.authorized.test"
  },
  "tools": {
    "runShell": "<bound function>",
    "httpRequest": "<bound function>",
    "browser": "<bound function>",
    "logger": "<bound function>"
  },
  "state": {
    "current": "INIT",
    "history": [],
    "session_ref": null
  },
  "memory": {
    "prior_findings": [],
    "asset_cache": {}
  }
}
